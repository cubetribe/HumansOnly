generator client {
    provider        = "prisma-client-js"
    previewFeatures = ["jsonProtocol"]
}

datasource db {
    provider          = "postgresql"
    url               = env("DATABASE_URL")
    directUrl         = env("DIRECT_DATABASE_URL")
}

model User {
    id               String         @id @default(uuid())
    clerkId          String?        @unique
    name             String?        @db.VarChar(50)
    description      String?        @db.VarChar(160)
    location         String?        @db.VarChar(30)
    website          String?        @db.VarChar(30)
    photoUrl         String?
    headerUrl        String?
    username         String         @unique @db.VarChar(20)
    password         String
    isVerifiedHuman  Boolean        @default(false)
    isPrivate        Boolean        @default(false)
    messagePrivacy   String         @default("everyone") @db.VarChar(20)
    role             String         @default("user") @db.VarChar(20)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @default(now()) @updatedAt
    createdTweets    Tweet[]        @relation("userTweets")
    retweets         Tweet[]        @relation("userRetweets")
    likedTweets      Tweet[]        @relation("userLikes")
    following        User[]         @relation("userFollows")
    followers        User[]         @relation("userFollows")
    sentMessages     Message[]      @relation("userMessagesSent")
    receivedMessages Message[]      @relation("userMessagesReceived")
    notifications    Notification[]
    notificationPreference NotificationPreference?
    mediaAssets      MediaAsset[]
    blocksInitiated  Block[]        @relation("blocksInitiated")
    blocksReceived   Block[]        @relation("blocksReceived")
    mutesInitiated   Mute[]         @relation("mutesInitiated")
    mutesReceived    Mute[]         @relation("mutesReceived")
    submittedReports Report[]       @relation("reportsSubmitted")
    reportsAgainstUser Report[]     @relation("reportsAgainstUser")
    policyAcceptances PolicyAcceptance[]
    challengeSessions HumanChallengeSession[]
    authenticityChecks AuthenticityCheck[] @relation("authenticityActor")
    reviewedAuthenticityChecks AuthenticityCheck[] @relation("authenticityReviewer")
}

model Tweet {
    id          String   @id @default(uuid())
    text        String   @db.VarChar(280)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt
    editedAt    DateTime?
    author      User     @relation("userTweets", fields: [authorId], references: [id])
    authorId    String
    photoUrl    String?
    likedBy     User[]   @relation("userLikes")
    retweetedBy User[]   @relation("userRetweets")
    replies     Tweet[]  @relation("tweetReplies")
    retweets    Tweet[]  @relation("retweetOf")
    isRetweet   Boolean  @default(false)
    retweetOf   Tweet?   @relation("retweetOf", fields: [retweetOfId], references: [id], onDelete: Cascade)
    retweetOfId String?
    isReply     Boolean  @default(false)
    repliedTo   Tweet?   @relation("tweetReplies", fields: [repliedToId], references: [id], onDelete: Cascade)
    repliedToId String?
    reports     Report[] @relation("reportsAgainstTweet")
    visibilityStatus    String  @default("public") @db.VarChar(20)
    authenticityScore   Float?
    authenticityDecision String? @db.VarChar(20)
    authenticityChecks  AuthenticityCheck[]
}

model Message {
    id          String   @id @default(uuid())
    text        String   @db.VarChar(280)
    createdAt   DateTime @default(now())
    sender      User     @relation("userMessagesSent", fields: [senderId], references: [id])
    senderId    String
    recipient   User     @relation("userMessagesReceived", fields: [recipientId], references: [id])
    recipientId String
    photoUrl    String?
    isRead      Boolean  @default(false)
}

model Notification {
    id        String   @id @default(uuid())
    type      String   @db.VarChar(20)
    content   String
    createdAt DateTime @default(now())
    isRead    Boolean  @default(false)
    user      User     @relation(fields: [userId], references: [id])
    userId    String
}

model MediaAsset {
    id               String   @id @default(uuid())
    owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
    ownerId          String
    provider         String   @db.VarChar(20)
    storageKey       String   @db.VarChar(255)
    url              String
    uploadType       String   @db.VarChar(20)
    mimeType         String   @db.VarChar(100)
    originalSize     Int
    compressedSize   Int
    checksum         String   @db.VarChar(64)
    width            Int?
    height           Int?
    moderationStatus String   @default("pending") @db.VarChar(20)
    moderationReason String?  @db.VarChar(160)
    provenanceStatus String   @default("unknown") @db.VarChar(20)
    provenanceSigner String?  @db.VarChar(160)
    provenanceDataJson Json?
    syntheticRiskScore Float?
    authenticityDecision String? @db.VarChar(20)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt
    authenticityChecks AuthenticityCheck[]

    @@index([ownerId, createdAt])
    @@index([checksum])
}

model PolicyDocument {
    id          String   @id @default(uuid())
    version     String   @unique @db.VarChar(40)
    locale      String   @default("en-US") @db.VarChar(12)
    title       String   @db.VarChar(160)
    sections    Json
    checksum    String   @db.VarChar(64)
    effectiveAt DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    acceptances PolicyAcceptance[]
}

model PolicyAcceptance {
    id               String         @id @default(uuid())
    user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId           String
    policyDocument   PolicyDocument @relation(fields: [policyDocumentId], references: [id], onDelete: Cascade)
    policyDocumentId String
    version          String         @db.VarChar(40)
    checksum         String         @db.VarChar(64)
    acceptedAt       DateTime       @default(now())
    ipHash           String?        @db.VarChar(64)
    userAgentHash    String?        @db.VarChar(64)
    createdAt        DateTime       @default(now())
    updatedAt        DateTime       @updatedAt

    @@unique([userId, policyDocumentId])
    @@index([userId, acceptedAt])
}

model HumanChallengeSession {
    id             String   @id @default(uuid())
    user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId         String
    action         String   @db.VarChar(40)
    provider       String   @db.VarChar(20)
    tokenHash      String   @db.VarChar(64)
    status         String   @default("verified") @db.VarChar(20)
    challengeScore Float?
    hostname       String?  @db.VarChar(160)
    ruleVersion    String?  @db.VarChar(40)
    errorCode      String?  @db.VarChar(120)
    responseJson   Json?
    verifiedAt     DateTime?
    expiresAt      DateTime
    usedAt         DateTime?
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    authenticityChecks AuthenticityCheck[]

    @@index([userId, action, status, expiresAt])
    @@index([tokenHash])
}

model AuthenticityCheck {
    id                 String                @id @default(uuid())
    actor              User                  @relation("authenticityActor", fields: [actorId], references: [id], onDelete: Cascade)
    actorId            String
    reviewer           User?                 @relation("authenticityReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
    reviewerId         String?
    tweet              Tweet?                @relation(fields: [tweetId], references: [id], onDelete: SetNull)
    tweetId            String?
    mediaAsset         MediaAsset?           @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
    mediaAssetId       String?
    challengeSession   HumanChallengeSession? @relation(fields: [challengeSessionId], references: [id], onDelete: SetNull)
    challengeSessionId String?
    action             String                @db.VarChar(40)
    subjectType        String                @db.VarChar(20)
    status             String                @default("open") @db.VarChar(20)
    decision           String                @default("allow") @db.VarChar(20)
    score              Float?
    challengeScore     Float?
    trustedTier        String?               @db.VarChar(20)
    ruleVersion        String?               @db.VarChar(40)
    modelVersion       String?               @db.VarChar(40)
    reasons            Json?
    contentText        String?               @db.VarChar(280)
    metadata           Json?
    reviewerNote       String?               @db.VarChar(500)
    reviewedAt         DateTime?
    createdAt          DateTime              @default(now())
    updatedAt          DateTime              @updatedAt

    @@index([status, createdAt])
    @@index([actorId, createdAt])
    @@index([decision, score])
}

model NotificationPreference {
    id        String   @id @default(uuid())
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String   @unique
    like      Boolean  @default(true)
    reply     Boolean  @default(true)
    follow    Boolean  @default(true)
    retweet   Boolean  @default(true)
    message   Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Block {
    id        String   @id @default(uuid())
    blocker   User     @relation("blocksInitiated", fields: [blockerId], references: [id], onDelete: Cascade)
    blockerId String
    blocked   User     @relation("blocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
    blockedId String
    createdAt DateTime @default(now())

    @@unique([blockerId, blockedId])
    @@index([blockedId])
}

model Mute {
    id        String   @id @default(uuid())
    muter     User     @relation("mutesInitiated", fields: [muterId], references: [id], onDelete: Cascade)
    muterId   String
    muted     User     @relation("mutesReceived", fields: [mutedId], references: [id], onDelete: Cascade)
    mutedId   String
    createdAt DateTime @default(now())

    @@unique([muterId, mutedId])
    @@index([mutedId])
}

model Report {
    id           String   @id @default(uuid())
    reporter     User     @relation("reportsSubmitted", fields: [reporterId], references: [id], onDelete: Cascade)
    reporterId   String
    targetUser   User?    @relation("reportsAgainstUser", fields: [targetUserId], references: [id], onDelete: SetNull)
    targetUserId String?
    targetTweet  Tweet?   @relation("reportsAgainstTweet", fields: [targetTweetId], references: [id], onDelete: SetNull)
    targetTweetId String?
    reason       String   @db.VarChar(80)
    details      String?  @db.VarChar(500)
    status       String   @default("open") @db.VarChar(20)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt

    @@index([status, createdAt])
    @@index([targetUserId])
    @@index([targetTweetId])
}
